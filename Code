import cv2
import pytesseract
import re
from google.colab.patches import cv2_imshow

# -------------------------
# Configure Tesseract Path (Change if needed)
# -------------------------
pytesseract.pytesseract.tesseract_cmd = r"/usr/bin/tesseract"

# -------------------------
# 2→ Normalize OCR Text
# -------------------------
def normalize(line):
    line = line.lower()
    line = line.replace('/', '-').replace('_', '-')
    line = re.sub(r'\s+', ' ', line)
    return line

# -------------------------
# 1→ Define Field Synonyms
# -------------------------
FIELDS = {
    "TOTAL": ["total", "total amount", "amount payable", "grand total", "final amount", "balance due"],
    "TAX": ["tax", "gst", "vat", "cgst", "sgst"],
    "SUBTOTAL": ["subtotal", "sub total"],
    "DATE": ["date", "bill date", "invoice date", "purchase date"]
}

# Collect all field keywords from the FIELDS dictionary and add 'invoice no.'
COMMON_FIELD_KEYWORDS = []
for key, values in FIELDS.items():
    COMMON_FIELD_KEYWORDS.extend(values)
COMMON_FIELD_KEYWORDS.extend(["invoice no", "invoice number"])
COMMON_FIELD_KEYWORDS = [normalize(k) for k in COMMON_FIELD_KEYWORDS]

# -------------------------
# 3→ Extract Fields From OCR Text (Enhanced Merchant Detection & Multi-line Invoice)
# -------------------------
def extract_fields(ocr_text):
    results = {}
    lines = ocr_text.split('\n')

    # -------- Merchant Detection --------
    merchant_candidates = [
        line.strip() for line in lines[:5] # Check a few more lines for merchant
        if line.strip() and \
           not re.search(r'\d', line) and \
           not any(keyword in normalize(line) for keyword in COMMON_FIELD_KEYWORDS)
    ]
    if merchant_candidates:
        results['MERCHANT'] = merchant_candidates[0]

    # -------- Invoice Number (Multi-line search) --------
    invoice_no_pattern = re.compile(r'(invoice\s*no\.?\s*[:\-]?\s*)(\w+)', re.IGNORECASE)
    for i in range(len(lines)):
        match = invoice_no_pattern.search(lines[i])
        if match:
            results["INVOICE_NO"] = match.group(2)
            break
        # If not found, try combining with the next line
        if i + 1 < len(lines):
            combined_line = lines[i] + " " + lines[i+1]
            match = invoice_no_pattern.search(combined_line)
            if match:
                results["INVOICE_NO"] = match.group(2)
                break

    # -------- Process Each Line --------
    for line in lines:
        normalized_line = normalize(line)

        for field, keywords in FIELDS.items():

            # Check keyword match
            if any(k in normalized_line for k in keywords):

                # -------- Extract Amounts --------
                if field in ["TOTAL", "TAX", "SUBTOTAL"]:
                    matches = re.findall(r'\d+\.\d{1,2}|\d+', line)
                    if matches:
                        results[field] = matches[-1]

                # -------- Extract Date --------
                if field == "DATE":
                    matches_date = re.findall(
                        r'\b(\d{1,2})[-\/](jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec|\d{1,2})[-\/](\d{2,4})\b',
                        line,
                        re.IGNORECASE
                    )

                    if matches_date:
                        day, month, year = matches_date[0]
                        if not month.isdigit():
                            month = month.capitalize()
                        results[field] = f"{day}-{month}-{year}"

    # -------- Currency Amount Detection (₹ or $) --------
    amount = re.search(r'[\u20B9\$]\s?([\d,]+\.?\d*)', ocr_text)
    if amount:
        results["CURRENCY_AMOUNT"] = amount.group(1)

    return results


# -------------------------
# 4→ Image Preprocessing + OCR
# -------------------------
def process_image(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    thresh = cv2.adaptiveThreshold(
        gray, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY, 31, 3
    )

    text = pytesseract.image_to_string(thresh, config="--psm 6")

    print("\nExtracted OCR Text:\n", text)

    extracted_data = extract_fields(text)

    print("\nExtracted Fields:\n", extracted_data)


# -------------------------
# 5→ Camera Capture Option
# -------------------------
def capture_from_camera():
    cap = cv2.VideoCapture(0)

    print("\nPress 's' to scan bill")
    print("Press 'q' to quit camera")

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        cv2_imshow(frame)
        key = cv2.waitKey(1) & 0xFF

        if key == ord('s'):
            print("\nScanning bill from camera...")
            process_image(frame)

        elif key == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()


# -------------------------
# 6→ Upload Image Option
# -------------------------
def upload_image():
    path = input("\nEnter image path: ")

    image = cv2.imread(path)

    if image is None:
        print("\u274c Invalid image path")
        return

    cv2_imshow(image)
    cv2.waitKey(2000)

    print("\nProcessing uploaded image...")
    process_image(image)

    cv2.destroyAllWindows()


# -------------------------
# 7→ Main Menu (User Choice)
# -------------------------
if __name__ == "__main__":

    while True:
        print("\n========== BILL OCR SYSTEM ==========")
        print("1 \u2192 Capture bill from Camera")
        print("2 \u2192 Upload image from System")
        print("3 \u2192 Exit")

        choice = input("Enter choice: ")

        if choice == "1":
            capture_from_camera()

        elif choice == "2":
            upload_image()

        elif choice == "3":
            print("Exiting program...")
            break

        else:
            print("Invalid choice. Try again.")
